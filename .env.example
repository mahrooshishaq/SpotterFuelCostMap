DJANGO_SECRET_KEY=replace-this-for-a-real-environment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Select PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fuel_stop_planner
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Remove DB_ENGINE and the DB_* values to use the SQLite fallback.
